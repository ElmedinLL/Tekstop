# Optional: base URL for Axios (see src/lib/api.ts). Must include API version segment.
# VITE_API_BASE_URL=http://localhost:5092/api/v1

# Vite dev server proxy target (default http://localhost:5092). If you see 502 on /api, the API is not reachable here.
# VITE_PROXY_TARGET=http://localhost:5092

# Stripe Checkout (publishable key — use pk_test_… in development)
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
