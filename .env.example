# Copy to .env and adjust values:  cp .env.example .env

# --- MySQL ---
MYSQL_ROOT_PASSWORD=ChangeMe_Use_A_Strong_Password
MYSQL_DATABASE=techvault
MYSQL_PORT=3306

# --- phpMyAdmin ---
PHPMYADMIN_PORT=8081

# --- API ---
# Must be at least 32 characters (HS256)
JWT_SECRET=ChangeMe_Use_At_Least_Thirty_Two_Chars_Secret_Key
JWT_ISSUER=TechVault
JWT_AUDIENCE=TechVault.API
JWT_EXPIRY_DAYS=7

API_PORT=5000
# Use Development to enable Swagger at http://localhost:5000/swagger
ASPNETCORE_ENVIRONMENT=Production

# Browser origins allowed to call the API with credentials (CORS)
CORS_ORIGIN_0=http://localhost
CORS_ORIGIN_1=http://127.0.0.1
CORS_ORIGIN_2=http://localhost:5173

# --- React / Nginx ---
WEB_PORT=80

# --- Stripe (optional) ---
# STRIPE_SECRET_KEY=
# STRIPE_PUBLISHABLE_KEY=
# STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd

# --- SMTP (optional) ---
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM_EMAIL=
# SMTP_FROM_NAME=TechVault
# SMTP_USE_SSL=true

# --- Optional Identity admin seed on API startup ---
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
